// Schéma de base de données — FIFAPRONO26
// Application de pronostics Coupe du Monde 2026

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("APP_DATABASE_URL")
  directUrl = env("APP_DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  favoriteCode String? // code pays alpha-2 du "coup de cœur"
  isAdmin       Boolean   @default(false)
  onboarded     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastSeenPosts DateTime? // dernière consultation du mur (pour les non-lus)

  matchPredictions MatchPrediction[]
  groupPredictions GroupPrediction[]
  longPrediction   LongPrediction?
  posts            Post[]
  snapshots        RankSnapshot[]
  pushSubs         PushSubscription[]
  reactions        Reaction[]
  mentions         Mention[]
}

model Team {
  id        String @id @default(cuid())
  name      String
  code      String @unique // code alpha-2 pour le drapeau (ex: FR, BR)
  groupName String // "A" .. "L"

  homeMatches Match[] @relation("home")
  awayMatches Match[] @relation("away")
}

model Match {
  id        String   @id @default(cuid())
  number    Int      @unique // numéro officiel du match
  stage     String // GROUP, R32, R16, QF, SF, THIRD, FINAL
  groupName String? // lettre du groupe pour la phase de poules
  kickoff   DateTime // coup d'envoi — verrouille les pronos
  venue     String?

  homeTeamId String?
  awayTeamId String?
  homeTeam   Team?   @relation("home", fields: [homeTeamId], references: [id])
  awayTeam   Team?   @relation("away", fields: [awayTeamId], references: [id])
  // libellés pour les matchs à venir dont l'équipe n'est pas encore connue (ex: "Vainqueur Groupe A")
  homeLabel String?
  awayLabel String?

  homeScore Int?
  awayScore Int?
  finished  Boolean @default(false)
  // Qualifié aux tirs au but quand un match à élimination directe finit sur un nul :
  // "HOME" ou "AWAY" (null si sans objet). N'affecte pas le calcul des points.
  shootoutWinner String?

  predictions MatchPrediction[]
}

model MatchPrediction {
  id        String @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int    @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

// Pronostic des qualifiés d'une poule (1er et 2e)
model GroupPrediction {
  id         String @id @default(cuid())
  userId     String
  groupName  String
  firstCode  String // code de l'équipe pronostiquée 1re
  secondCode String // code de l'équipe pronostiquée 2e
  points     Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupName])
}

// Pronostics long terme (avant le tournoi) : vainqueur final + finaliste
model LongPrediction {
  id           String  @id @default(cuid())
  userId       String  @unique
  championCode String // code de l'équipe championne pronostiquée
  finalistCode String? // finaliste (optionnel)
  points       Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Réglages globaux (clé/valeur) : double points phase finale, etc.
model Setting {
  key   String @id
  value String
}

// Demande d'aide « mot de passe oublié » envoyée à l'admin (depuis la page de connexion)
model HelpRequest {
  id        String   @id @default(cuid())
  email     String
  message   String?
  createdAt DateTime @default(now())
}

// Chambrage : mur de messages entre amis
model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())

  // Réponse à un autre message (citation). Si le parent est supprimé, on garde
  // le message mais on perd la citation (SetNull).
  replyToId String?
  replyTo   Post?   @relation("PostReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Post[]  @relation("PostReplies")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  mentions  Mention[]

  @@index([replyToId])
}

// Réaction emoji à un message
model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
}

// Mention d'un joueur dans un message
model Mention {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Instantané quotidien du total de points (pour le graphique d'évolution)
model RankSnapshot {
  id        String   @id @default(cuid())
  userId    String
  day       String // "AAAA-MM-JJ" pour dédupliquer un point par jour
  points    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// Abonnement aux notifications push (PWA)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
